generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  displayName  String    @default("Nguyễn Đình Thanh") @map("display_name")
  email        String?
  phone        String?
  address      String?
  avatar       String?
  passwordHash String    @map("password_hash")
  role         AdminRole @default(EDITOR)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("admin_users")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]

  @@map("categories")
}

model Product {
  id             Int      @id @default(autoincrement())
  name           String
  slug           String   @unique
  imageUrl       String?  @map("image_url")
  specifications Json?
  content        String?
  categoryId     Int      @map("category_id")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  category       Category @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

model Project {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  imageUrl    String?   @map("image_url")
  content     String?
  completedAt DateTime? @map("completed_at")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("projects")
}

model Inquiry {
  id               Int      @id @default(autoincrement())
  name             String
  email            String
  phone            String
  service_interest String   @map("service_interest")
  message          String
  status           String   @default("Mới")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("inquiries")
}

model CallClickLog {
  id        Int      @id @default(autoincrement())
  ipAddress String?  @map("ip_address")
  country   String?
  city      String?
  page      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("call_click_logs")
}

model Article {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  category  String?
  content   String?
  imageUrl  String?  @map("image_url")
  status    String   @default("PUBLISHED")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("articles")
}

model Service {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  category  String?
  content   String?
  imageUrl  String?  @map("image_url")
  status    String   @default("HIỂN THỊ")
  order     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("services")
}

model SiteSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model SiteImage {
  id        Int      @id @default(autoincrement())
  title     String?
  name      String?
  key       String?  @unique
  imageUrl  String   @map("image_url")
  location  String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_images")
}

model VisitorSession {
  id        Int      @id @default(autoincrement())
  sessionId String   @unique @map("session_id")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  lastPing  DateTime @default(now()) @map("last_ping")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("visitor_sessions")
}

enum AdminRole {
  ADMIN
  EDITOR
}
